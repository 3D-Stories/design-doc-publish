# Copy to `.env` in this directory, fill the values, then `docker compose up -d --build harness`.
# `.env` is gitignored. Never commit it, and never paste a value into a chat or an issue.
#
# TWO readers, ONE file. `docker compose` reads it unasked for the harness, and
# `scripts/publish_doc.py` reads it through `user_config.load_env()`. A variable you have
# already exported always wins, so exporting by hand stays a supported way to run.

# ---- the harness needs these two, and refuses to start without either ----

# A GitHub fine-grained personal access token, READ-ONLY.
#   Resource owner:         3D-Stories          (harness/config.py:173)
#   Repository access:      all repositories    (it lists the org at /orgs/{owner}/repos)
#   Repository permissions: Contents = Read-only, Metadata = Read-only
# Used at harness/__main__.py:67 to read every document and build the index.
DOC_HARNESS_GITHUB_TOKEN=

# A shared bearer password on the publish endpoint, compared at harness/control.py:61.
# Any long random string. Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# The publisher sends this same value, which is why one file serves both halves.
DOC_HARNESS_PUBLISH_TOKEN=

# ---- the publisher needs this one, and publishes nothing without it (exit 25) ----

# Any address that REACHES the harness. The publisher sets the `Host: docs-control.<zone>`
# header itself (scripts/publish_doc.py:689), so the address does not have to be that name.
# On the harness host, the loopback port from compose.local-port.yaml is one, verified live:
#   curl -H 'Host: docs-control.3dstories.ca' http://127.0.0.1:18081/   ->  401, not 404
# DOC_HARNESS_CONTROL_URL=http://127.0.0.1:18081

# ---- optional ----

# Stage 6's edge half. Unset SKIPS that half and exits 26, which is not a pass.
# Must be https: Cloudflare Access service tokens are sent to it.
# DOC_HARNESS_PUBLIC_BASE=https://3dstories.ca

# Defaults to 3dstories.ca.
# DOC_HARNESS_ZONE=3dstories.ca
