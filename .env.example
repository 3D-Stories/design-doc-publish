# Copy to `.env` in this directory, fill both values, then `docker compose up -d --build harness`.
# `.env` is gitignored. Never commit it, and never paste a value into a chat or an issue.

# A GitHub fine-grained personal access token, READ-ONLY.
#   Resource owner:       3D-Stories          (harness/config.py:173)
#   Repository access:    all repositories    (it lists the org at /orgs/{owner}/repos)
#   Repository permissions: Contents = Read-only, Metadata = Read-only
# Used at harness/__main__.py:67 to read every document and build the index.
DOC_HARNESS_GITHUB_TOKEN=

# A shared bearer password on the publish endpoint, compared at harness/control.py:61.
# Any long random string. Generate one with:  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Whatever goes here must also be exported when running scripts/publish_doc.py.
DOC_HARNESS_PUBLISH_TOKEN=

# Optional. Defaults to 3dstories.ca.
# DOC_HARNESS_ZONE=3dstories.ca
